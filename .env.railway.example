# Copy these variables into the Railway service, then fill in the credentials.
BOT_TOKEN=
API_ID=
API_HASH=
ADMIN_IDS=

# Generate locally with: python -m scripts.export_session
# Paste the contents of sessions/railway-session.txt here in Railway only.
TELETHON_STRING_SESSION=

# Attach a Railway volume at /data before the first deployment.
DATABASE_URL=sqlite:////data/forwarder.db
TELETHON_SESSION=/data/forwarder_session

LOG_LEVEL=INFO
LOG_TO_FILE=false
FORWARD_DELAY=1.5
PROGRESS_UPDATE_INTERVAL=3
PROXY_ENABLED=false

# Optional defaults. Admins can configure AI in the bot's private Settings menu.
AI_ENABLED=false
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-6-luna
AI_FALLBACK_MODEL=gpt-5.6-luna
NEWS_GROUNDING_ENABLED=true
NEWS_ALLOWED_DOMAINS=tasnimnews.com,tasnimnews.ir,farsnews.ir,iribnews.ir
# Empty uses the bundled app/prompts/guardrails.txt policy.
AI_GUARDRAILS=

# Optional compact guard tuning; these are the defaults.
AI_GUARD_CONFIDENCE_THRESHOLD=0.85
AI_GUARD_MAX_INPUT_CHARS=4000
AI_GUARD_MAX_OUTPUT_TOKENS=1024
AI_GUARD_MAX_CANDIDATES=8
AI_GUARD_MAX_TOPICS=5
AI_GUARD_MAX_ENTITIES=8
AI_GUARD_MAX_ALIASES=8
AI_GUARD_CONTEXT_TTL_HOURS=24
AI_GUARD_CACHE_TTL_SECONDS=600
AI_GUARD_CACHE_SIZE=256
AI_GUARD_TIMEOUT_SECONDS=60
AI_GUARD_TOTAL_TIMEOUT_SECONDS=120
AI_GUARD_MAX_STAGES=6
AI_GUARD_MAX_REQUESTS=8
AI_GUARD_FAILURE_LIMIT=2
AI_GUARD_COOLDOWN_SECONDS=60
