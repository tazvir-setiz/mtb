# ==== Bot API ====
# از BotFather در تلگرام دریافت می‌شود
BOT_TOKEN=123456:ABCDEF...

# ==== Telegram MTProto (Telethon) ====
# از my.telegram.org -> API Development Tools دریافت می‌شود
API_ID=12345678
API_HASH=xxxxxxxxxxxxxxxxxxxxxxxx

# لیست شناسه عددی ادمین‌ها (با کاما جدا شود)
ADMIN_IDS=123456789,987654321

# مسیر دیتابیس
DATABASE_URL=sqlite:///data/forwarder.db

# مسیر session فایل Telethon (بدون پسوند)
TELETHON_SESSION=sessions/forwarder_session

# اختیاری: برای ورود غیرتعاملی سرور؛ با scripts.export_session ساخته می‌شود
TELETHON_STRING_SESSION=

# سطح لاگ
LOG_LEVEL=INFO
LOG_TO_FILE=true

# فاصله زمانی پیش‌فرض بین Forward هر پیام (ثانیه)
FORWARD_DELAY=1.5

# حداقل فاصله به‌روزرسانی پیام Progress (ثانیه)
PROGRESS_UPDATE_INTERVAL=3

PROXY_ENABLED=true
PROXY_TYPE=socks5
PROXY_HOST=127.0.0.1
PROXY_PORT=12334

# ==== تنظیمات هوش مصنوعی (AI) ====
AI_ENABLED=true
AI_API_KEY=sk-your-api-key-here
AI_BASE_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
AI_GUARDRAILS="شما یک فیلترچی هوشمند هستید. ۱- کلمات رکیک را با '***' جایگزین کن. ۲- اگر در متن نام یا آیدی کانال دیگری بود، آن را به آیدی '@MyChannel' تغییر بده. ۳- لینک‌های سایت‌های خبری را کلاً حذف کن."
