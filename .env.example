# ==== Bot API ====
# از BotFather در تلگرام دریافت می‌شود
BOT_TOKEN=123456:ABCDEF...

# ==== Telegram MTProto (Telethon) ====
# از my.telegram.org -> API Development Tools دریافت می‌شود
API_ID=12345678
API_HASH=xxxxxxxxxxxxxxxxxxxxxxxx

# لیست شناسه عددی ادمین‌ها (با کاما جدا شود)
ADMIN_IDS=123456789,987654321

# مسیر دیتابیس
DATABASE_URL=sqlite:///data/forwarder.db

# مسیر session فایل Telethon (بدون پسوند)
TELETHON_SESSION=sessions/forwarder_session

# اختیاری: برای ورود غیرتعاملی سرور؛ با scripts.export_session ساخته می‌شود
TELETHON_STRING_SESSION=

# سطح لاگ
LOG_LEVEL=INFO
LOG_TO_FILE=true

# فاصله زمانی پیش‌فرض بین Forward هر پیام (ثانیه)
FORWARD_DELAY=1.5

# حداقل فاصله به‌روزرسانی پیام Progress (ثانیه)
PROGRESS_UPDATE_INTERVAL=3

PROXY_ENABLED=true
PROXY_TYPE=socks5
PROXY_HOST=127.0.0.1
PROXY_PORT=12334

# ==== تنظیمات هوش مصنوعی (AI) ====
# Optional defaults; saved Telegram bot settings take precedence.
AI_ENABLED=true
AI_API_KEY=sk-your-api-key-here
AI_BASE_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
# Empty uses app/prompts/guardrails.txt; username rules are managed in the bot.
AI_GUARDRAILS=

# Compact guard: uncertain text uses AI; clear local decisions do not.
AI_GUARD_CONFIDENCE_THRESHOLD=0.85
AI_GUARD_AI_CONFIDENCE_THRESHOLD=0.75
AI_GUARD_MAX_INPUT_CHARS=4000
AI_GUARD_MAX_OUTPUT_TOKENS=1024
AI_GUARD_MAX_CANDIDATES=8
AI_GUARD_MAX_TOPICS=5
AI_GUARD_MAX_ENTITIES=8
AI_GUARD_MAX_ALIASES=8
AI_GUARD_CONTEXT_TTL_HOURS=24
AI_GUARD_CACHE_TTL_SECONDS=600
AI_GUARD_CACHE_SIZE=256
AI_GUARD_TIMEOUT_SECONDS=20
AI_GUARD_FAILURE_LIMIT=2
AI_GUARD_COOLDOWN_SECONDS=60
